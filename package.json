{
  "name": "wanikani-for-code",
  "displayName": "WaniCode",
  "description": "Unofficial WaniKani client for VS Code. Do your reviews and lessons in the editor. Not affiliated with WaniKani or Tofugu.",
  "version": "0.3.0",
  "publisher": "demilul",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "wanikani",
    "japanese",
    "kanji",
    "srs",
    "language learning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/demilul/wanikani-for-code.git"
  },
  "bugs": {
    "url": "https://github.com/demilul/wanikani-for-code/issues"
  },
  "homepage": "https://github.com/demilul/wanikani-for-code#readme",
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wanikani.setToken",
        "title": "Set API Token",
        "category": "WaniCode"
      },
      {
        "command": "wanikani.clearToken",
        "title": "Clear API Token",
        "category": "WaniCode"
      },
      {
        "command": "wanikani.showDashboard",
        "title": "Show Dashboard",
        "category": "WaniCode"
      },
      {
        "command": "wanikani.startReviews",
        "title": "Start Reviews",
        "category": "WaniCode",
        "icon": "$(play)"
      },
      {
        "command": "wanikani.startLessons",
        "title": "Start Lessons",
        "category": "WaniCode",
        "icon": "$(mortar-board)"
      },
      {
        "command": "wanikani.refresh",
        "title": "Refresh",
        "category": "WaniCode",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wanikani",
          "title": "WaniCode",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "wanikani": [
        {
          "id": "wanikani.dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wanikani.dashboard",
        "contents": "Connect your WaniKani account to see your reviews and lessons.\n[Set API Token](command:wanikani.setToken)\n\nYour token is stored securely in VS Code's SecretStorage and is never written to disk in plain text."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wanikani.startReviews",
          "when": "view == wanikani.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "wanikani.startLessons",
          "when": "view == wanikani.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "wanikani.refresh",
          "when": "view == wanikani.dashboard",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "WaniCode",
      "properties": {
        "wanikani.practiceMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When enabled, reviews and lessons run the full experience but are **not** submitted to WaniKani, so nothing is written to your real SRS. Leave this **off** for normal studying; turn it on when you want to drill without affecting your progress."
        },
        "wanikani.lessonBatchSize": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "description": "How many lessons to teach and quiz per session."
        },
        "wanikani.lessonOrder": {
          "type": "string",
          "enum": [
            "shuffled",
            "level"
          ],
          "enumDescriptions": [
            "Draw each batch at random from the pool of available lessons (WaniKani's default).",
            "Take lessons in ascending level, then radical to kanji to vocabulary."
          ],
          "default": "shuffled",
          "description": "How to pick which lessons to study next from the available pool."
        },
        "wanikani.refreshInterval": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "markdownDescription": "How often (in minutes) to poll WaniKani for new reviews and lessons."
        },
        "wanikani.notifyOnDue": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when new reviews become available."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "test": "esbuild tests/matcher.test.ts --bundle --platform=node --format=cjs --outfile=dist/test.cjs && node dist/test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "wanakana": "^5.3.1"
  }
}
